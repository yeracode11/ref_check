# Экспорт Excel (GET /api/admin/export-fridges) — иначе 504 / timeout в браузере:
#   proxy_read_timeout 900s;
#   proxy_connect_timeout 60s;
#   proxy_send_timeout 900s;
#   client_max_body_size 25m;
# HTTP_LONG_RUNNING_MS=900000  (таймаут сокета Node, по умолчанию 15 мин)
# CHECKIN_STATS_USE_LEGACY=true — только если снова появятся чекины без fridgeRef (после cleanup 2026 не включать)
# EXPORT_SKIP_LEGACY_BROKEN=false — учитывать legacy «сломанные» в экспорте (по умолчанию пропускаются)
# Если в админке GET /api/admin/fridge-status?all=true даёт 502 — увеличьте таймаут nginx до бэкенда:
#   proxy_read_timeout 600s;
#   (в location, где proxy_pass на порт 4000)

MONGODB_URI=mongodb://localhost:27017/fridge_manager
# Локальный MongoDB на VPS (нет mongod.service → не установлен):
#   cd fridge-manager && sudo bash scripts/install-mongodb-ubuntu.sh
#   bash scripts/detect-mongodb.sh   — что есть на сервере
#   bash scripts/ensure-mongodb.sh && pm2 restart fridge-manager
# Восстановление из бэкапа: mongorestore --gzip --archive=/backups/fridge_manager_*.gz --uri="$MONGODB_URI"
# При нехватке RAM (4 GB) после установки cache ~1.25 GB в /etc/mongod.conf

PORT=4000
# Список origin через запятую (не используйте * с credentials).
# www-вариант для stellref.kz подставляется автоматически; для других доменов укажите явно.
CORS_ORIGIN=https://stellref.kz
JWT_SECRET=change-this-secret-key-in-production
BODY_LIMIT_MB=10
UPLOAD_LIMIT_MB=25
CHECKIN_IDEMPOTENCY_WINDOW_MS=300000

# Публичный URL для ссылок на загруженные фото (отметки, ремонты)
PUBLIC_BASE_URL=https://stellref.kz
JWT_EXPIRES=7d
PHOTO_UPLOAD_MAX_MB=8

# MongoDB Atlas: если на сервере POST /api/auth/login даёт 500 и в логах
# MongoNetworkTimeoutError / ReplicaSetNoPrimary — проверьте Network Access в Atlas
# (IP сервера или 0.0.0.0/0 для теста), что кластер не на паузе, и исходящий порт 27017.
# Опционально — увеличить таймауты (мс), если канал до Atlas очень медленный:
# MONGOOSE_SERVER_SELECTION_TIMEOUT_MS=60000
# MONGOOSE_CONNECT_TIMEOUT_MS=60000
# MONGOOSE_SOCKET_TIMEOUT_MS=120000

